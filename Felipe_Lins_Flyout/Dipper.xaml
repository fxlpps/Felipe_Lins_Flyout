<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Felipe_Lins_Flyout.Dipper"
             Title="Dipper">
    <ScrollView>
        <VerticalStackLayout
           Padding="35,0"
           Spacing="25" BackgroundColor="#407ba5">

            <Image
               Margin="0, 40, 0, 10"
               Source="dipperpines.png"
               HeightRequest="205"
               Aspect="AspectFit"
               />

            <Label
               Text="Mason 'Dipper' Pines é um garoto inteligente, curioso e aventureiro de 13 anos (12 anos antes dos eventos do final da série ), e o herói principal da série . Junto com sua irmã gêmea Mabel , ele passa o verão de 2012 com seu tio-avô Stan em Gravity Falls, Oregon, onde ele e sua irmã constantemente se deparam com as tendências paranormais da cidade. Munido do Diário 3 , que ele encontrou em um compartimento escondido enterrado na Floresta de Gravity Falls , ele e Mabel trabalham para descobrir os misteriosos segredos da cidade."
               FontFamily="Coolvetica"
               Style="{StaticResource SubHeadline}"
               TextColor="#FFFFFF"
               HorizontalTextAlignment="Start"/>

        </VerticalStackLayout>
        </ScrollView>
</ContentPage>