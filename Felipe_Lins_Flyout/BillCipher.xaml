<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Felipe_Lins_Flyout.BillCipher"
             Title="BillCipher">
    <ScrollView>
        <VerticalStackLayout
   Padding="35,0"
   Spacing="25" BackgroundColor="#171717">

            <Image
               Margin="0, 40, 0, 10"
               Source="billcipher.png"
               HeightRequest="205"
               Aspect="AspectFit"
             />

            <Label
                Text="Bill Cipher é uma entidade sobrenatural poderosa, caótica e extremamente manipuladora, conhecida por assumir a forma de um pequeno triângulo amarelo com um único olho. Originário de uma dimensão misteriosa, ele é capaz de entrar nos sonhos e na mente das pessoas, além de possuir poderes que desafiam as leis da realidade. Ao longo dos eventos de Gravity Falls, Bill busca realizar seus planos para conquistar e transformar o mundo, fazendo acordos com aqueles que considera úteis. Extremamente inteligente e imprevisível, ele usa seu carisma, suas mentiras e seus poderes para manipular seus inimigos e espalhar o caos."
                FontFamily="Coolvetica"
                Style="{StaticResource SubHeadline}"
                TextColor="#FFFFFF"
                HorizontalTextAlignment="Start"
            />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>