<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Felipe_Lins_Flyout.BillCipher"
             Title="BillCipher">
    <VerticalStackLayout
   Padding="35,0"
   Spacing="25" BackgroundColor="#CBCB23">

            <Image
               Margin="0, 40, 0, 10"
               Source="billcipher.png"
               HeightRequest="205"
               Aspect="AspectFit"
             />

            <Label
                Text="Teste"
                FontFamily="Coolvetica"
                Style="{StaticResource SubHeadline}"
                TextColor="#FFFFFF"
                HorizontalTextAlignment="Start"
            />

        </VerticalStackLayout>
</ContentPage>